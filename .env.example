# Primer promenljivih okruženja. Kopirati u .env.local i popuniti vrednosti.
# Pravi .env fajlovi se NIKADA ne čuvaju u git-u.
# Opis svake promenljive: docs/07-uputstvo-za-implementaciju.md, sekcija 0.

# Supabase (Faza 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tajni ključ — koristi ga samo scripts/seed-demo.mts, nikada kod u src/
SUPABASE_SERVICE_ROLE_KEY=

# Adresa aplikacije (za linkove u emailovima i povratak sa Google prijave).
# Ako nije podešena, koristi se adresa sa koje je stigao zahtev.
# Ista adresa se upisuje u Supabase: Authentication -> URL Configuration (Site URL i Redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Real-time provajder: supabase | websocket
NEXT_PUBLIC_REALTIME_PROVIDER=supabase
NEXT_PUBLIC_REALTIME_WS_URL=

# Prikaz Swagger UI na /api-docs: true | false
SWAGGER_ENABLED=true
